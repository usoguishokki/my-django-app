<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Filenames are content-addressed by collectstatic, so they are immutable. -->
    <httpProtocol>
      <customHeaders>
        <remove name="Cache-Control" />
        <add name="Cache-Control" value="public, max-age=31536000, immutable" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
