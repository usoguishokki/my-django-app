<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Mutable/static source URLs must never retain stale release content. -->
    <httpProtocol>
      <customHeaders>
        <remove name="Cache-Control" />
        <add name="Cache-Control" value="no-store, max-age=0" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
