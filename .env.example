# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=

# Fresh Nika Starter configuration, translated to existing NAGAKUSA_* names.
# Final HTTPS endpoints verified by GET; issued HTTP URLs redirect.
# Credentials belong only in ignored .env; no automatic registration.
# AI_ENABLED controls tools; AI_AGENT_MODE=host declares only ai.message.send.
NAGAKUSA_PLUGIN_KEY=nika
NAGAKUSA_PLUGIN_APP_KEY=nika
NAGAKUSA_PLUGIN_MODULE_SLUG=nika
NAGAKUSA_PLUGIN_LABEL=Nika
NAGAKUSA_PLUGIN_VERSION=0.1.0
NAGAKUSA_RUNTIME_BASE_URL=http://133.222.52.74:8011/
NAGAKUSA_PLUGIN_AI_API_TOKEN=
NAGAKUSA_REGISTRATION_KEY=
NAGAKUSA_BASE_URL=https://nagakusa-dx.toyota-shokki.co.jp/
NAGAKUSA_REGISTRATION_API_URL=https://nagakusa-dx.toyota-shokki.co.jp/api/pluginhub/register/
NAGAKUSA_PLUGIN_SPEC_API_URL=https://nagakusa-dx.toyota-shokki.co.jp/api/pluginhub/spec-channel/
NAGAKUSA_PLUGIN_AI_ENABLED=0
NAGAKUSA_PLUGIN_AI_AGENT_MODE=host
NAGAKUSA_HOST_PLUGIN_URL=https://nagakusa-dx.toyota-shokki.co.jp/plugins/nika/

# Oracle
ORACLE_DATABASE_NAME=
ORACLE_DATABASE_USER=
